# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Paystack ──────────────────────────────────────────────────────────────────
# Public key only — the secret key lives in Supabase Edge Function secrets,
# never in the frontend bundle.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Google Maps ───────────────────────────────────────────────────────────────
# Required for trip route maps, live tracking map, and GPS address lookup.
# Get a key at: https://console.cloud.google.com/google/maps-apis/
# Enable these two APIs: Maps JavaScript API + Geocoding API
# Restrict the key to your production domain + localhost for development.
VITE_GOOGLE_MAPS_API_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Leave blank to disable error tracking entirely.
VITE_SENTRY_DSN=
