{
  "name": "kd-ops-timetrack-agent",
  "version": "1.0.1",
  "private": true,
  "description": "Native desktop agent for KD Ops Hub Time Tracking — window/app activity capture and optional screenshots. Self-contained; not built or linted by the main web app's toolchain.",
  "author": {
    "name": "KD Squares",
    "email": "code@kdsquares.com"
  },
  "homepage": "https://github.com/King-Iyene/kd-ops-hub/tree/main/desktop-agent",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node scripts/write-config.js",
    "build": "npm run prebuild && tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish=never",
    "release": "npm run build && electron-builder --publish=always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "active-win": "^8.2.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "node-gyp": "^10.3.1"
  },
  "build": {
    "appId": "com.kdsquares.timetrack-agent",
    "productName": "KD Ops Time Tracker",
    "files": ["dist/**/*", "src/renderer/**/*"],
    "directories": { "output": "release" },
    "icon": "build/icon.png",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "King-Iyene",
      "repo": "kd-ops-hub"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
