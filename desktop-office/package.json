{
  "name": "kd-ops-desktop",
  "version": "0.3.8",
  "private": true,
  "description": "KD Ops: the KD Squares ops site and the virtual Office as one desktop app",
  "author": {
    "name": "KD Squares",
    "email": "code@kdsquares.com"
  },
  "homepage": "https://github.com/King-Iyene/kd-ops-hub/tree/main/desktop-office",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --publish=never",
    "test": "node test/desktop.test.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "com.kdsquares.office",
    "productName": "KD Ops",
    "files": [
      "main.js",
      "update-cache.js",
      "preload.js",
      "preload-tabs.js",
      "preload-mini.js",
      "preload-picker.js",
      "picker.html",
      "mini.html",
      "tabs.html",
      "offline.html",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "build/tray@3x.png"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "KD-Ops-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "KD-Ops-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KD Ops",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KD Ops uses your microphone so you can talk to people in the office.",
        "NSCameraUsageDescription": "KD Ops uses your camera so people in the office can see you.",
        "NSScreenCaptureUsageDescription": "KD Ops shares your screen when you choose to."
      },
      "artifactName": "KD-Ops-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "KD-Ops-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/King-Iyene/kd-ops-hub/releases/download/kd-ops-desktop-channel"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
